{
  "rules": {
    ".read": false,
    ".write": false,
    "sesiones": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('hash').isString() && root.child('codigos').child(newData.child('hash').val()).child('activo').val() === true && (!newData.child('username').exists() || newData.child('username').val() === root.child('codigos').child(newData.child('hash').val()).child('username').val())"
      }
    },
    "codigos": {
      "$hash": {
        ".read": "auth != null && (root.child('sesiones').child(auth.uid).child('hash').val() === $hash || (auth != null && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('activo').val() === true && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('rol').val() === 'admin'))",
        ".write": "auth != null && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('activo').val() === true && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('rol').val() === 'admin'"
      }
    },
    "usuarios": {
      ".read": "auth != null && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('activo').val() === true && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('rol').val() === 'admin'",
      "$usuario": {
        ".write": "auth != null && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('activo').val() === true && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('rol').val() === 'admin'"
      }
    },
    "dispositivos": {
      ".read": "auth != null && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('activo').val() === true",
      "$imei": {
        ".write": "auth != null && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('activo').val() === true"
      },
      ".indexOn": [
        "actualizado_en"
      ]
    },
    "asignaciones": {
      ".read": "auth != null && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('activo').val() === true",
      ".indexOn": [
        "imei",
        "registrado_en"
      ],
      "$id": {
        ".write": "auth != null && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('activo').val() === true && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['imei','nombre','cedula','tipo','fecha_ingreso','registrado_en','usuario','origen'])",
        "imei": {
          ".validate": "newData.isString() && newData.val().length >= 14"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length >= 3"
        },
        "cedula": {
          ".validate": "newData.isString()"
        },
        "tipo": {
          ".validate": "newData.val() === 'ASIGNACION' || newData.val() === 'REASIGNACION' || newData.val() === 'EDICION' || newData.val() === 'CAMBIO_LABOR'"
        },
        "labor": {
          ".validate": "newData.val() === 'Aplicador' || newData.val() === 'Sanidad' || newData.val() === 'Mantenimiento' || newData.val() === 'Cosecha' || newData.val() === 'Fertilización' || newData.val() === 'Reubicado' || newData.val() === 'Supervisor' || newData.val() === 'Administrativo'"
        },
        "fecha_ingreso": {
          ".validate": "newData.isString()"
        },
        "registrado_en": {
          ".validate": "newData.val() === now"
        },
        "usuario": {
          ".validate": "newData.val() === root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('username').val()"
        },
        "origen": {
          ".validate": "newData.val() === 'apk' || newData.val() === 'web'"
        },
        "observacion": {
          ".validate": "newData.isString()"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "personal": {
      ".read": "auth != null && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('activo').val() === true",
      ".indexOn": [
        "actualizado_en"
      ],
      "$cedula": {
        ".write": "auth != null && root.child('codigos').child(root.child('sesiones').child(auth.uid).child('hash').val()).child('activo').val() === true",
        ".validate": "newData.hasChildren(['nombre','cedula','activo','actualizado_en']) && newData.child('cedula').val() === $cedula && newData.child('nombre').isString() && newData.child('nombre').val().length >= 3 && newData.child('activo').isBoolean() && newData.child('actualizado_en').val() === now"
      }
    }
  }
}